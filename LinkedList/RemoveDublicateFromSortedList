class Solution {
    public ListNode deleteDuplicates(ListNode head) {
        ListNode temp = head;
        int size = 0;
        while(temp!=null){
            temp=temp.next;
            size++;
        }
        if(size==0) return null;
        temp=head;
        while(temp.next!=null){
            if(temp.val==temp.next.val){
                temp.next=temp.next.next;
            }
            else{
                temp=temp.next;
            }
        }
        return head;
    }
}
